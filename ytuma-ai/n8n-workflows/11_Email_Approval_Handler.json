      ]
    },
    "Sheets_Update_Approved": { "main": [[{ "node": "Resolve Client Config", "type": "main", "index": 0 }]] },
    "Resolve Client Config": { "main": [[{ "node": "Send Approved Email", "type": "main", "index": 0 }]] },
    "Send Approved Email": { "main": [[{ "node": "Telegram_Approved_Confirm", "type": "main", "index": 0 }]] },
    "Update row in sheet": { "main": [[{ "node": "Telegram_Edited_Confirm", "type": "main", "index": 0 }]] },
    "Sheets_Update_Cancelled": { "main": [[{ "node": "Telegram_Cancelled_Confirm", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" }
}
